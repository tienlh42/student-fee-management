# --- Postgres ---
POSTGRES_DB=hocphi
POSTGRES_USER=hocphi_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Sinh key moi: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Đường dẫn Django admin — đổi khỏi mặc định cho đỡ bị bot dò quét, PHẢI kết
# thúc bằng "/". Không lộ đường dẫn này ra ngoài (app không có link tới trang
# này) — ai cần vào tự lưu URL.
DJANGO_ADMIN_URL=doi-duong-dan-nay-di/

# --- Mã hoá dữ liệu ngân hàng ---
# Sinh key mới: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Đổi key sẽ làm mất khả năng giải mã số tài khoản đã lưu — không đổi tuỳ tiện.
BANK_ACCOUNT_ENCRYPTION_KEY=changeme

# --- Root account (seed_root_account) ---
# Chạy: docker compose exec web python manage.py seed_root_account
# Đổi giá trị rồi chạy lại lệnh là cách tạo mới/reset mật khẩu tài khoản root.
ROOT_ACCOUNT_USERNAME=changeme
ROOT_ACCOUNT_PASSWORD=changeme

# --- Caddy ---
DOMAIN=yourdomain.com
